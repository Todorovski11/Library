@model Domain.Models.ShoppingCart

@{
    ViewBag.Title = "Edit Shopping Cart";
}

<link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
<link href="https://cdnjs.cloudflare.com/ajax/libs/select2/4.1.0-beta.1/css/select2.min.css" rel="stylesheet" />
<script src="https://cdnjs.cloudflare.com/ajax/libs/select2/4.1.0-beta.1/js/select2.min.js"></script>

<h2 class="text-center mb-4">Edit Shopping Cart</h2>

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-body">
                    <h4 class="card-title text-primary mb-4">Update Shopping Cart Details</h4>
                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                    @using (Html.BeginForm("Edit", "ShoppingCarts", FormMethod.Post, new { id = "edit-form", @class = "needs-validation", novalidate = "novalidate" }))
                    {
                        @Html.AntiForgeryToken()

                        <!-- Hidden ID Field -->
                        @Html.HiddenFor(model => model.Id)

                        <!-- Owner Dropdown -->
                        <div class="form-group">
                            @Html.LabelFor(model => model.OwnerId, "Owner", htmlAttributes: new { @class = "text-muted mb-1" })
                            @Html.DropDownListFor(model => model.OwnerId, (SelectList)ViewBag.OwnerId, "Select Owner", new { @class = "form-control select2" })
                            @Html.ValidationMessageFor(model => model.OwnerId, "", new { @class = "text-danger" })
                        </div>

                        <div class="text-center mt-4">
                            <button type="submit" class="btn btn-primary">Save</button>
                            <a href="/ShoppingCarts/Index" class="btn btn-secondary ml-3">Cancel</a>
                        </div>
                    }
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        $('.select2').select2();
    });
</script>
