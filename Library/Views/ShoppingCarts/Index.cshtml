@model Domain.DTO.ShoppingCartDto

@{
    ViewBag.Title = "Shopping Cart";
}

<link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">

<h2 class="text-center mb-4">Shopping Cart</h2>

<div class="container">
    <div class="row">
        <div class="col-12">
            <!-- Display Total Price -->
            @if (Model.TotalPrice > 0)
            {
                <form id="payment-form" action="/ShoppingCarts/PayOrder" method="post">
                    <script src="https://checkout.stripe.com/checkout.js"
                            class="stripe-button"
                            data-key="your-publishable-key-here"
                            data-locale="auto"
                            data-description="Payment for Items"
                            data-amount="@(Model.TotalPrice * 100)"
                            data-label="Pay $@Model.TotalPrice"
                            data-onclick="handlePayment()">
                    </script>
                </form>
            }
        </div>

        <!-- Shopping Cart Table -->
        <div class="col-12 mt-3">
            <div class="card shadow border-0 rounded">
                <div class="card-body">
                    <h4 class="card-title mb-4">Cart Items</h4>
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Book Title</th>
                                <th>Price</th>
                                <th>Quantity</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.Books.Count(); i++)
                            {
                                var item = Model.Books[i];
                                <tr id="row-@item.Book.Id">
                                    <td>@(i + 1)</td>
                                    <td>@item.Book.Title</td>
                                    <td>@item.Book.Price</td>
                                    <td>@item.Quantity</td>
                                    <td>
                                        <!-- Delete Button -->
                                        <button type="button" class="btn btn-danger btn-sm"
                                                onclick="deleteItem('@item.Book.Id')">
                                            Delete
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <th colspan="4" class="text-right">Total:</th>
                                <th id="total-price">$@Model.TotalPrice</th>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Success Payment Modal -->
<div class="modal fade" id="paymentSuccessModal" tabindex="-1" role="dialog" aria-labelledby="paymentSuccessLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="paymentSuccessLabel">Payment Successful</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                Your payment was successfully processed!
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-dismiss="modal">OK</button>
            </div>
        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>

<script>
    // Handle payment success
    function handlePayment() {
        $.ajax({
            url: '/ShoppingCarts/SuccessPayment',
            method: 'GET',
            success: function (response) {
                if (response.success) {
                    $('#paymentSuccessModal').modal('show'); // Show the success modal
                }
            },
            error: function (xhr, status, error) {
                console.error("AJAX error:", error);
            }
        });
    }

    // Function to delete an item from the cart
    function deleteItem(bookId) {
        if (confirm("Are you sure you want to delete this item?")) {
            $.ajax({
                url: '/ShoppingCarts/DeleteFromShoppingCart',
                type: 'POST',
                data: {
                    id: bookId,
                    __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                },
                success: function (response) {
                    if (response.success) {
                        // Remove the deleted row
                        $('#row-' + bookId).remove();

                        // Recalculate and update the total price
                        let newTotal = 0;
                        $('tbody tr').each(function () {
                            const price = parseFloat($(this).find('td:eq(2)').text());
                            const quantity = parseInt($(this).find('td:eq(3)').text());
                            newTotal += price * quantity;
                        });
                        $('#total-price').text('$' + newTotal.toFixed(2));

                        alert("Item removed successfully.");
                    } else {
                        alert("Failed to delete the item: " + response.error);
                    }
                },
                error: function (xhr, status, error) {
                    console.error("AJAX error:", error);
                    alert("Error deleting item.");
                }
            });
        }
    }
</script>
