@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@Html.AntiForgeryToken()

@model IEnumerable<Domain.Models.Publisher>

@{
    ViewBag.Title = "Publishers";
}

<link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">

<h2 class="text-center mb-4">Publishers</h2>

<div class="container">
    <div class="row">
        <div class="col-12">
            <!-- Create button -->
            <a href="/Publishers/Create" class="btn btn-primary mb-3">Add New Publisher</a>

            <table class="table table-bordered table-striped">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Address</th>
                        <th>Books Count</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var publisher in Model)
                    {
                        <tr>
                            <td>@publisher.Name</td>
                            <td>@publisher.Address</td>
                            <td>@(publisher.Books?.Count() ?? 0)</td>
                            <td>
                                <!-- Manually specified URLs -->
                                <a href="/Publishers/Details/@publisher.Id" class="btn btn-info btn-sm">Details</a>
                                <a href="/Publishers/Edit/@publisher.Id" class="btn btn-warning btn-sm">Edit</a>

                                <!-- Delete Button -->
                                <button type="button" class="btn btn-danger btn-sm"
                                        onclick="showDeleteModal('@publisher.Id')">
                                    Delete
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" role="dialog" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteModalLabel">Confirm Deletion</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                Are you sure you want to delete this publisher?
                <input type="hidden" id="deletePublisherId" value="" />
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" onclick="deletePublisher()">Delete</button>
            </div>
        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>

<script>
    // Show the delete confirmation modal
    function showDeleteModal(publisherId) {
        $('#deletePublisherId').val(publisherId); // Set publisher ID in the modal
        $('#deleteModal').modal('show'); // Show the modal
    }

    function deletePublisher() {
        var publisherId = $('#deletePublisherId').val(); // Get publisher ID from hidden input

        $.ajax({
            url: '/Publishers/Delete',
            type: 'POST',
            data: {
                id: publisherId,
                __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val() // Include the anti-forgery token
            },
            success: function (response) {
                if (response.success) {
                    $('#deleteModal').modal('hide'); // Hide the modal
                    location.reload(); // Reload the page to reflect changes
                } else {
                    alert('Failed to delete the publisher: ' + response.error);
                }
            },
            error: function (xhr, status, error) {
                console.error('AJAX error:', error);
                alert('Error deleting publisher.');
            }
        });
    }
</script>
